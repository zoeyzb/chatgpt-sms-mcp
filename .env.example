# Optional: exact Messages service/account label to prefer when sending.
MESSAGES_SERVICE_NAME=

# Optional override for the Messages database path.
MESSAGES_DB_PATH=~/Library/Messages/chat.db

# Google Voice automation is experimental and disabled by default.
GOOGLE_VOICE_ENABLED=false
GOOGLE_VOICE_PROFILE_DIR=~/.chatgpt-sms-mcp/google-voice-profile
GOOGLE_VOICE_HEADLESS=false

# Safety defaults.
CONFIRMATION_TTL_MS=300000
MESSAGE_RATE_LIMIT_PER_HOUR=30
RECIPIENT_ALLOWLIST=
